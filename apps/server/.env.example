DATABASE_URL=http://127.0.0.1:8080
DATABASE_AUTH_TOKEN=
NODE_ENV=production
UNKEY_TOKEN=
TINY_BIRD_API_KEY=
# Tinybird instance for pipes and audit logs. Defaults to the cloud API;
# point at http://tinybird-local:7181 for the local container.
TINYBIRD_URL=
# Set to "true" to resolve every pipe and ingest to empty instead of calling
# Tinybird — keeps local runs off the configured instance.
TINYBIRD_NOOP=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RESEND_API_KEY=
TWILLIO_AUTH_TOKEN=your_auth_token
TWILLIO_ACCOUNT_ID=your_account_id

SCREENSHOT_SERVICE_URL=http://your.endpoint
QSTASH_TOKEN=your_token

NEXT_PUBLIC_OPENPANEL_CLIENT_ID=
OPENPANEL_CLIENT_SECRET=