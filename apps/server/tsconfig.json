{
  "extends": "../../packages/tsconfig/base.json",
  "include": ["src", "*.ts", "**/*.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "jsxImportSource": "react",
    "allowJs": true,
    "paths": {
      "@/*": ["./src/*"],
      "@openstatus/analytics-real": ["../../packages/analytics/src/index.ts"],
      "@openstatus/subscriptions-real": [
        "../../packages/subscriptions/src/index.ts"
      ],
      "@openstatus/tinybird-real": ["../../packages/tinybird/src/index.ts"]
    }
  }
}
