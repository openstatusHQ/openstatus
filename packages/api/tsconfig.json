{
  "extends": "@openstatus/tsconfig/base.json",
  "include": ["src", "*.ts"],
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "resolveJsonModule": true
  },
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/test/**",
    "**/*.mock.ts",
    "**/test-preload.ts"
  ]
}
