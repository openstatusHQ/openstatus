# Data Source created from Pipe 'aggregate__icmp_uptime_90d__v0'

SCHEMA >
    `time` DateTime,
    `region` String,
    `requestStatus` Nullable(String),
    `monitorId` Int32,
    `workspaceId` Int32

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(time)"
ENGINE_SORTING_KEY "monitorId, time"
ENGINE_TTL "time + toIntervalDay(90)"
