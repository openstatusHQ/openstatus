# Data Source created from Pipe 'aggregate__grpc_quorum_45d__v0'
# One row per scheduled cloud run; private-location rows are filtered out.

SCHEMA >
    `time` DateTime('UTC'),
    `monitorId` String,
    `cronTimestamp` Int64,
    `errorRegions` AggregateFunction(uniqExact, String),
    `degradedOrErrorRegions` AggregateFunction(uniqExact, String)

ENGINE "AggregatingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(time)"
ENGINE_SORTING_KEY "monitorId, time, cronTimestamp"
ENGINE_TTL "time + toIntervalDay(47)"
