# Data Source created from Pipe 'aggregate__icmp_full_14d__v0'

SCHEMA >
    `time` DateTime,
    `monitorId` Int32,
    `region` String,
    `timestamp` Int64,
    `cronTimestamp` Int64,
    `timing` String,
    `workspaceId` Int32,
    `latency` Int64,
    `latencyMin` Int64,
    `latencyMax` Int64,
    `packetsSent` UInt8,
    `packetsReceived` UInt8,
    `errorMessage` Nullable(String),
    `error` Int16,
    `trigger` Nullable(String),
    `uri` Nullable(String),
    `id` Nullable(String),
    `requestStatus` Nullable(String)

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(time)"
ENGINE_SORTING_KEY "monitorId, time"
ENGINE_TTL "time + toIntervalDay(14)"
