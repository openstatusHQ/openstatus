# Data Source created from Pipe 'aggregate__dns_14d__v0'

SCHEMA >
    `time` DateTime,
    `id` String,
    `uri` String,
    `latency` Int16,
    `region` String,
    `trigger` String,
    `timestamp` Int64,
    `cronTimestamp` Int64,
    `monitorId` Int16,
    `requestStatus` String,
    `records` String

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(time)"
ENGINE_SORTING_KEY "monitorId, time"
ENGINE_TTL "time + toIntervalDay(14)"
