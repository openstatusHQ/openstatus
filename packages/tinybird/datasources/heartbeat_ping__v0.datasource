SCHEMA >
    `id` String `json:$.id`,
    `timestamp` Int64 `json:$.timestamp`,
    `monitorId` Int32 `json:$.monitorId`,
    `workspaceId` Int32 `json:$.workspaceId`,
    `ip` Nullable(String) `json:$.ip`,
    `method` LowCardinality(String) `json:$.method`,
    `userAgent` Nullable(String) `json:$.userAgent`,
    `headers` Nullable(String) `json:$.headers`,
    `body` Nullable(String) `json:$.body`,
    `bodyTruncated` Int8 `json:$.bodyTruncated`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(fromUnixTimestamp64Milli(timestamp))"
ENGINE_SORTING_KEY "monitorId, timestamp"
