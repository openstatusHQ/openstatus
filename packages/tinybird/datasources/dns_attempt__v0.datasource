DESCRIPTION >
    Failed attempts of a retried DNS check. The final attempt is in dns_response__v0; join on monitorId, region, cronTimestamp.

SCHEMA >
    `assertions` String `json:$.assertions`,
    `cronTimestamp` Int64 `json:$.cronTimestamp`,
    `error` Int16 `json:$.error`,
    `errorMessage` String `json:$.errorMessage`,
    `id` String `json:$.id`,
    `latency` Int32 `json:$.latency`,
    `monitorId` Int32 `json:$.monitorId`,
    `records` String `json:$.records`,
    `region` String `json:$.region`,
    `requestStatus` String `json:$.requestStatus`,
    `timestamp` Int64 `json:$.timestamp`,
    `trigger` String `json:$.trigger`,
    `uri` String `json:$.uri`,
    `workspaceId` Int32 `json:$.workspaceId`,
    `attempt` UInt8 `json:$.attempt`

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(fromUnixTimestamp64Milli(cronTimestamp))"
ENGINE_SORTING_KEY "monitorId, cronTimestamp, region, attempt"
