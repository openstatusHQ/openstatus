# Data Source created from Pipe 'aggregate__grpc_runs_45d__v0'
# Partial aggregates per scheduled cloud run until merges run; read with *Merge per run.
# Private-location rows are filtered out.

SCHEMA >
    `time` DateTime('UTC'),
    `monitorId` String,
    `cronTimestamp` Int64,
    `count` AggregateFunction(count),
    `success` AggregateFunction(count, Nullable(UInt8)),
    `error` AggregateFunction(count, Nullable(UInt8)),
    `degraded` AggregateFunction(count, Nullable(UInt8))

ENGINE "AggregatingMergeTree"
ENGINE_PARTITION_KEY "toYYYYMM(time)"
ENGINE_SORTING_KEY "monitorId, time, cronTimestamp"
ENGINE_TTL "time + toIntervalDay(47)"
