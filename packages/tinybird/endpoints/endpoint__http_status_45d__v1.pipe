TOKEN "endpoint__http_status_45d__v0_5279_dup_endpoint_read_1013" READ

NODE endpoint
SQL >

%
{% if String(type, 'requests') == 'runs' %}
SELECT
    day,
    monitorId,
    count() AS count,
    countIf(runErrorRegions * 2 < n AND runDegradedOrErrorRegions * 2 < n) AS ok,
    countIf(runErrorRegions * 2 >= n) AS error,
    countIf(runErrorRegions * 2 < n AND runDegradedOrErrorRegions * 2 >= n) AS degraded
FROM (
    SELECT
        time AS day,
        monitorId,
        cronTimestamp,
        uniqExactMerge(errorRegions) AS runErrorRegions,
        uniqExactMerge(degradedOrErrorRegions) AS runDegradedOrErrorRegions,
        arrayElement({{ Array(regionCounts, 'Int32', '0') }}, indexOf({{ Array(monitorIds, 'String', '1,666') }}, monitorId)) AS n
    FROM mv__http_runs_45d__v0
    WHERE monitorId IN {{ Array(monitorIds, 'String', '1,666') }}
    GROUP BY day, monitorId, cronTimestamp
)
WHERE n > 0
GROUP BY day, monitorId
ORDER BY day DESC
{% else %}
SELECT
    time as day,
    monitorId,
    countMerge(count) as count,
    countMerge(success) as ok,
    countMerge(error) as error,
    countMerge(degraded) as degraded
FROM mv__http_status_45d__v1
WHERE monitorId IN {{ Array(monitorIds, 'String', '1,666') }}
GROUP BY day, monitorId
ORDER BY day DESC
{% end %}

TYPE endpoint


