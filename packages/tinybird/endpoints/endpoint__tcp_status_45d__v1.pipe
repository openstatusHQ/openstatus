TOKEN "endpoint__tcp_status_45d__v1_endpoint_read_8911" READ

NODE endpoint
SQL >

%
{% if String(type, 'requests') == 'runs' %}
SELECT
    day,
    monitorId,
    count() AS count,
    countIf(e * 2 < n AND (e + d) * 2 < n) AS ok,
    countIf(e * 2 >= n) AS error,
    countIf(e * 2 < n AND (e + d) * 2 >= n) AS degraded
FROM (
    SELECT
        time AS day,
        monitorId,
        cronTimestamp,
        countMerge(count) AS n,
        countMerge(error) AS e,
        countMerge(degraded) AS d
    FROM mv__tcp_runs_45d__v0
    WHERE monitorId IN {{ Array(monitorIds, 'String', '4433') }}
    GROUP BY day, monitorId, cronTimestamp
)
GROUP BY day, monitorId
ORDER BY day DESC
{% else %}
SELECT
    time as day,
    monitorId,
    countMerge(count) as count,
    countMerge(success) as ok,
    countMerge(error) as error,
    countMerge(degraded) as degraded
FROM mv__tcp_status_45d__v1
WHERE monitorId IN {{ Array(monitorIds, 'String', '4433') }}
GROUP BY day, monitorId
ORDER BY day DESC
{% end %}

TYPE endpoint


