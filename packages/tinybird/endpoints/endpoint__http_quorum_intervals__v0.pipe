TOKEN "endpoint__http_quorum_intervals__v0_endpoint_read" READ

NODE endpoint
SQL >

%
-- Per `interval` bucket: how many scheduled cloud runs had each (errorRegions,
-- degradedOrErrorRegions) combination. The bucket expression and the
-- fromDate/toDate bounds mirror the paired uptime endpoint on the run's
-- cronTimestamp, so keys match.
SELECT
    interval,
    runErrorRegions AS errorRegions,
    runDegradedOrErrorRegions AS degradedOrErrorRegions,
    count() AS runs
FROM (
    SELECT
        toStartOfInterval(toDateTime(fromUnixTimestamp64Milli(cronTimestamp)), INTERVAL {{ String(interval, '30', required=True) }} minute) AS interval,
        cronTimestamp,
        uniqExactMerge(errorRegions) AS runErrorRegions,
        uniqExactMerge(degradedOrErrorRegions) AS runDegradedOrErrorRegions
    FROM mv__http_quorum_45d__v0
    WHERE
        monitorId = {{ String(monitorId, '1', required=True) }}
        {% if fromDate %}
            AND time >= toStartOfDay(parseDateTimeBestEffortOrNull({{ String(fromDate) }}))
            AND toDateTime(fromUnixTimestamp64Milli(cronTimestamp)) >= parseDateTimeBestEffortOrNull({{ String(fromDate) }})
        {% end %}
        {% if toDate %}
            AND time <= parseDateTimeBestEffortOrNull({{ String(toDate) }})
            AND toDateTime(fromUnixTimestamp64Milli(cronTimestamp)) <= parseDateTimeBestEffortOrNull({{ String(toDate) }})
        {% end %}
    GROUP BY interval, cronTimestamp
)
GROUP BY interval, errorRegions, degradedOrErrorRegions
ORDER BY interval DESC

TYPE endpoint
