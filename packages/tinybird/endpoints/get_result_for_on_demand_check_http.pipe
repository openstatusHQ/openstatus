TOKEN "getResultForOnDemandCheck_endpoint_read_7832" READ

NODE get_result_for_on_demand_check_http_0
SQL >

%
SELECT
    latency,
    monitorId,
    error,
    region,
    statusCode,
    timestamp,
    url,
    workspaceId,
    timing,
    cronTimestamp
FROM mv__http_full_30d__v0
where
     cronTimestamp = {{ String(timestamp, '1729871694536') }} and 
     monitorId = {{ String(monitorId, '2260') }}
    and url = {{ String(url , 'https://www.openstatus.dev/api/ping/edge') }}
    order by cronTimestamp desc

TYPE endpoint


