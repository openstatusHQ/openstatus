TOKEN "endpoint__heartbeat_status_45d__v0_endpoint_read" READ

NODE endpoint
SQL >

%
-- Ping activity per day: success pings are `ok`, `/fail` pings are `error`.
-- A missed ping writes no row, so this is not uptime. Downtime lives in the
-- heartbeat's incidents.
SELECT
    toStartOfDay(toTimeZone(fromUnixTimestamp64Milli(timestamp), 'UTC')) AS day,
    monitorId,
    count() AS count,
    countIf(kind != 'fail') AS ok,
    countIf(kind = 'fail') AS error,
    0 AS degraded
FROM heartbeat_ping__v0
WHERE monitorId IN {{ Array(monitorIds, 'String', '1') }}
    AND timestamp >= toUnixTimestamp64Milli(toDateTime64(toStartOfDay(now() - INTERVAL 45 DAY), 3))
GROUP BY day, monitorId
ORDER BY day DESC

TYPE endpoint
