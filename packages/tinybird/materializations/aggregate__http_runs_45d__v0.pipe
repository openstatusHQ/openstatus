NODE aggregate
SQL >

    SELECT
        toStartOfDay(toTimeZone(fromUnixTimestamp64Milli(cronTimestamp), 'UTC')) AS time,
        monitorId,
        cronTimestamp,
        countState() AS count,
        countState(if(coalesce(requestStatus, '') = 'success', 1, NULL)) AS success,
        countState(if(coalesce(requestStatus, '') = 'error', 1, NULL)) AS error,
        countState(if(coalesce(requestStatus, '') = 'degraded', 1, NULL)) AS degraded
    FROM ping_response__v8
    WHERE coalesce(nullIf(trigger, ''), 'cron') = 'cron'
        -- private locations carry no shared run key
        AND NOT match(region, '^[0-9]+$')
    GROUP BY
        time,
        monitorId,
        cronTimestamp

TYPE materialized
DATASOURCE mv__http_runs_45d__v0
