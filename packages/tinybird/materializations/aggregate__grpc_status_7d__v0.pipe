TAGS "grpc"

NODE aggregate
SQL >

    SELECT
        toStartOfDay(toTimeZone(fromUnixTimestamp64Milli(cronTimestamp), 'UTC')) AS time,
        monitorId,
        countState() AS count,
        countState(if(error = 0, 1, NULL)) AS ok
    FROM grpc_response__v0
    GROUP BY
        time,
        monitorId

TYPE materialized
DATASOURCE mv__grpc_status_7d__v0
