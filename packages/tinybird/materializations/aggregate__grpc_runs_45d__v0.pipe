NODE aggregate
SQL >

    SELECT
        toStartOfDay(toTimeZone(fromUnixTimestamp64Milli(cronTimestamp), 'UTC')) AS time,
        toString(monitorId) AS monitorId,
        cronTimestamp,
        uniqExactStateIf(CAST(region, 'String'), coalesce(nullIf(requestStatus, ''), if(error != 0, 'error', '')) = 'error') AS errorRegions,
        uniqExactStateIf(CAST(region, 'String'), coalesce(nullIf(requestStatus, ''), if(error != 0, 'error', '')) IN ('error', 'degraded')) AS degradedOrErrorRegions
    FROM grpc_response__v0
    WHERE coalesce(nullIf(trigger, ''), 'cron') = 'cron'
        -- private locations carry no shared run key
        AND NOT match(region, '^[0-9]+$')
    GROUP BY
        time,
        monitorId,
        cronTimestamp

TYPE materialized
DATASOURCE mv__grpc_runs_45d__v0
