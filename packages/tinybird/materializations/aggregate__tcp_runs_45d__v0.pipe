NODE aggregate
SQL >

    SELECT
        toStartOfDay(toTimeZone(fromUnixTimestamp64Milli(cronTimestamp), 'UTC')) AS time,
        toString(monitorId) AS monitorId,
        cronTimestamp,
        countState() AS count,
        countState(if(coalesce(nullIf(requestStatus, ''), if(error != 0, 'error', '')) = 'success', 1, NULL)) AS success,
        countState(if(coalesce(nullIf(requestStatus, ''), if(error != 0, 'error', '')) = 'error', 1, NULL)) AS error,
        countState(if(coalesce(nullIf(requestStatus, ''), if(error != 0, 'error', '')) = 'degraded', 1, NULL)) AS degraded
    FROM tcp_response__v0
    WHERE coalesce(nullIf(trigger, ''), 'cron') = 'cron'
        -- private locations carry no shared run key
        AND NOT match(region, '^[0-9]+$')
        -- cloud rows ingested while cronTimestamp read $.timestamp carry no shared run key
        AND cronTimestamp != timestamp
    GROUP BY
        time,
        monitorId,
        cronTimestamp

TYPE materialized
DATASOURCE mv__tcp_runs_45d__v0
