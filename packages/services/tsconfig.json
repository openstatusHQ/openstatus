{
  "extends": "@openstatus/tsconfig/base.json",
  "include": ["src", "test"],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/test/**",
    "**/*.mock.ts",
    "**/test-preload.ts"
  ],
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler"
  }
}
