{
  "extends": "@openstatus/tsconfig/base.json",
  "include": [".", "src/env.ts"],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "**/test/**",
    "**/*.mock.ts",
    "**/test-preload.ts"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "resolveJsonModule": true
  }
}
